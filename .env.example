# Database
DATABASE_URL=postgresql://laf_user:laf_password@localhost:5432/lostandfound

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Lost & Found <no-reply@example.com>"

# App
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
